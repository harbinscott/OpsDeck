[Unit]
Description=OpsDeck PAM authentication request
Requires=opsdeck-auth.socket
After=opsdeck-auth.socket

[Service]
Type=oneshot
User=root
Group=root
Environment=OPSDECK_ADMIN_GROUPS=sudo,admin,wheel
EnvironmentFile=-/etc/opsdeck/auth.env
ExecStart=/usr/local/libexec/opsdeck-auth
StandardInput=socket
StandardOutput=socket
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
